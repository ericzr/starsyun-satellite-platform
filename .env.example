# StarSyun 环境变量配置示例
# 复制此文件为 .env 用于开发环境
# 复制此文件为 .env.production 用于生产环境

# API 配置
VITE_API_BASE_URL=https://api.starsyun.com
VITE_API_TIMEOUT=30000

# 地图配置
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_MAP_ACCESS_TOKEN=

# 第三方服务（如需要）
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=

# 功能开关
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_DATA=true
