# Set this on the Vercel production deployment to use the server-side provider gateway.
# Leave unset for GitHub Pages/local preview to query Earth Search directly.
VITE_STAC_GATEWAY_URL=/api/stac

# Public browser endpoint for inquiry submission. Use a same-origin Vercel function in production.
VITE_INQUIRY_API_URL=/api/inquiries

# Optional public Carto basemap key. Restrict this key to your production
# domains in the Carto dashboard. Without it, the Carto option uses the free
# OpenFreeMap monochrome fallback instead of showing a blank map.
VITE_CARTO_API_KEY=

# Optional Carto style endpoint. Leave unset to use the built-in dark-matter /
# positron style URLs.
VITE_MAP_STYLE_URL=

# Server-only Vercel variable. Never prefix this with VITE_.
ALLOWED_ORIGINS=https://starsyun.com,https://www.starsyun.com

# Server-only Supabase persistence variables. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_ANON_KEY=replace-with-supabase-anon-key-for-customer-auth

# Server-only bootstrap admin session. Keep every value out of VITE_* variables.
ADMIN_EMAILS=ops@starsyun.com
ADMIN_PASSWORD_SHA256=replace-with-sha256-of-admin-password
AUTH_SESSION_SECRET=replace-with-a-random-32-byte-secret

# Server-only payment provider. Leave unset until Stripe is configured.
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
