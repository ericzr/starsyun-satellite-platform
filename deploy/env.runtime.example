# Runtime-only configuration. Install as /etc/starsyun/starsyun.env with mode 0600.
# Never prefix secrets with VITE_ and never commit the real values.
ALLOWED_ORIGINS=https://starsyun.com,https://www.starsyun.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
ADMIN_EMAILS=ops@starsyun.com
ADMIN_PASSWORD_SHA256=replace-with-sha256-of-admin-password
AUTH_SESSION_SECRET=replace-with-random-32-byte-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional runtime tuning.
REQUEST_BODY_LIMIT_BYTES=1048576
