[Unit]
Description=StarSyun provider synchronization
After=network-online.target starsyun.service
Wants=network-online.target

[Service]
Type=oneshot
User=starsyun
Group=starsyun
WorkingDirectory=/srv/starsyun/current
EnvironmentFile=/etc/starsyun/starsyun.env
Environment=PROVIDER_SYNC_PROVIDERS=earth-search,copernicus,planetary-computer
ExecStart=/usr/bin/node /srv/starsyun/current/scripts/provider-sync.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=90
